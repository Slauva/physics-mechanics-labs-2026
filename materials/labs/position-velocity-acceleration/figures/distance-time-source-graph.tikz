\begin{tikzpicture}
  \begin{axis}[
    width=10.6cm,
    height=6.05cm,
    axis lines=left,
    axis line style={PhysicsNavy,-{Latex[length=2.1mm]}},
    xmin=0,xmax=22,
    ymin=0,ymax=2.15,
    xtick={0,5,...,20},
    ytick={0,0.5,...,2.0},
    minor x tick num=4,
    minor y tick num=4,
    xlabel={$t$ (\si{\second})},
    ylabel={$S$ (\si{\metre})},
    tick label style={font=\scriptsize\sffamily},
    label style={font=\small\sffamily},
    grid=both,
    major grid style={PhysicsMuted!55,line width=0.45pt},
    minor grid style={PhysicsLine,line width=0.3pt}
  ]
    % Source-graph reconstruction.  The Bezier joins preserve three graphical
    % readings used in the supplied solution: a maximum slope of 0.25 m/s on
    % the central segment, a tangent through the origin at t = 16 s, and the
    % final point (20 s, 2.0 m).
    \draw[PhysicsNavy,line width=1.65pt]
      (axis cs:0,0)
      .. controls (axis cs:4,0) and (axis cs:9,0.25) .. (axis cs:10,0.50)
      .. controls (axis cs:11,0.75) and (axis cs:13,1.25) .. (axis cs:14,1.50)
      .. controls (axis cs:14.6667,1.6667) and (axis cs:15.3333,1.7633)
        .. (axis cs:16,1.84)
      .. controls (axis cs:17.3333,1.9933) and (axis cs:18.6667,2.00)
        .. (axis cs:20,2.00)
      -- (axis cs:22,2.00);
    \node[anchor=north west,font=\tiny\sffamily,text=PhysicsMuted,
      fill=white,fill opacity=0.88,text opacity=1,inner sep=1.5pt]
      at (axis description cs:0.015,0.985) {source-graph reconstruction};

    \ifdefined\showaveragesecant
      \draw[PhysicsBlue,line width=1.5pt]
        (axis cs:0,0) -- (axis cs:20,2.00);
      \draw[PhysicsBlue,densely dashed,line width=0.9pt]
        (axis cs:20,0) -- (axis cs:20,2.00);
      \fill[PhysicsBlue] (axis cs:0,0) circle[radius=1.8pt]
        (axis cs:20,2.00) circle[radius=1.8pt];
      \node[anchor=south east,font=\scriptsize\sffamily\bfseries,
        text=PhysicsBlue,fill=white,inner sep=1pt]
        at (axis cs:1.0,0.03) {$O$};
      \node[anchor=south east,font=\scriptsize\sffamily\bfseries,
        text=PhysicsBlue,fill=white,inner sep=1pt]
        at (axis cs:19.75,1.94) {$F$};
      \node[anchor=north west,font=\scriptsize\sffamily,text=PhysicsBlue,
        fill=white,inner sep=1.5pt]
        at (axis cs:2.4,0.56) {full-motion secant $OF$};
    \fi

    \ifdefined\showmaxtangent
      \draw[PhysicsRed,line width=1.5pt]
        (axis cs:9,0.25) -- (axis cs:15,1.75);
      \draw[PhysicsRed,densely dashed,line width=1.05pt]
        (axis cs:10,0.50) -- (axis cs:14,0.50) -- (axis cs:14,1.50);
      \fill[PhysicsRed] (axis cs:10,0.50) circle[radius=1.8pt]
        (axis cs:14,0.50) circle[radius=1.8pt]
        (axis cs:14,1.50) circle[radius=1.8pt];
      \node[anchor=north east,font=\scriptsize\sffamily\bfseries,
        text=PhysicsRed,fill=white,inner sep=1pt]
        at (axis cs:9.9,0.48) {$A$};
      \node[anchor=north west,font=\scriptsize\sffamily\bfseries,
        text=PhysicsRed,fill=white,inner sep=1pt]
        at (axis cs:14.05,0.48) {$B$};
      \node[anchor=south west,font=\scriptsize\sffamily\bfseries,
        text=PhysicsRed,fill=white,inner sep=1pt]
        at (axis cs:14.05,1.52) {$C$};
      \node[anchor=north,font=\scriptsize\sffamily,text=PhysicsRed,
        fill=white,inner sep=1.2pt]
        at (axis cs:12,0.47) {$\Delta t=\SI{4}{\second}$};
      \node[anchor=south,font=\scriptsize\sffamily,text=PhysicsRed,
        fill=white,inner sep=1.2pt,rotate=90]
        at (axis cs:14.15,1.00) {$\Delta S=\SI{1.0}{\metre}$};
      \node[anchor=south east,font=\scriptsize\sffamily,text=PhysicsRed,
        fill=white,inner sep=1.5pt]
        at (axis cs:14.8,1.78) {steepest tangent $AC$};
    \fi

    \ifdefined\showequaltangent
      \draw[PhysicsGold,line width=1.55pt]
        (axis cs:0,0) -- (axis cs:16,1.84);
      \draw[PhysicsGold,densely dashed,line width=1.0pt]
        (axis cs:16,0) -- (axis cs:16,1.84);
      \fill[PhysicsGold!75!black] (axis cs:0,0) circle[radius=1.8pt]
        (axis cs:16,1.84) circle[radius=1.8pt];
      \node[anchor=south east,font=\scriptsize\sffamily\bfseries,
        text=PhysicsGold!70!black,fill=white,inner sep=1pt]
        at (axis cs:1.0,0.03) {$O$};
      \node[anchor=south west,font=\scriptsize\sffamily\bfseries,
        text=PhysicsGold!70!black,fill=white,inner sep=1pt]
        at (axis cs:16.05,1.84) {$D$};
      \node[anchor=south,font=\scriptsize\sffamily\bfseries,
        text=PhysicsGold!70!black,fill=white,inner sep=1.2pt]
        at (axis cs:16,0.05) {$t_0\approx\SI{16}{\second}$};
      \node[anchor=south east,font=\scriptsize\sffamily,
        text=PhysicsGold!70!black,fill=white,inner sep=1.5pt]
        at (axis cs:12.7,1.53) {secant $OD$ = tangent at $D$};
    \fi
  \end{axis}
\end{tikzpicture}
