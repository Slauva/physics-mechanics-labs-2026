\begin{tikzpicture}[font=\small,>=Latex]
  \draw[physics line] (0,2.5)--(5,0);
  \draw[dashed,PhysicsMuted] (0,0)--(5,0);
  \draw (4,0) arc[start angle=180,end angle=153.435,radius=1];
  \node at (3.65,.27) {$\alpha$};
  \begin{scope}[shift={(1.55,1.725)},rotate=-26.565]
    \draw[physics line,fill=PhysicsCyan] (-.4,0) rectangle(.4,.5);
    \coordinate (B) at (0,.25);
  \end{scope}
  \node[above left] at (0,2.5) {$x=0$};
  \draw[->,PhysicsBlue,thick] (2.9,1.9)--(4,1.35) node[right] {$x$};
  \draw[->] (2.9,1.9)--(3.35,2.8) node[above] {$y$};
  \node at (1.1,3.4) {$k(x)=fx$};
  \iflabforces
    \draw[physics force] (B)--++(0,-1.4) node[below] {$mg$};
    \draw[physics force] (B)--++(.55,1.1) node[above] {$N$};
    \draw[physics force] (B)--++(-1,.5) node[above right] {$k(x)N$};
  \else
    \node[above] at (1,.5) {$v(0)=0$};
  \fi
  \node[PhysicsMuted] at (2.5,-.65) {Schematic; not to scale};
\end{tikzpicture}
