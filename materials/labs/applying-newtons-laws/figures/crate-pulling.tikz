\begin{tikzpicture}[font=\small,>=Latex]
  \draw[physics line] (-.6,0)--(5.1,0);
  \draw[physics line,fill=PhysicsCyan] (1,0) rectangle (2.8,1);
  \coordinate (B) at (1.9,.5);
  \draw[physics force] (2.8,.6)--(4.55,1.6) node[right] {$F$};
  \draw[dashed,PhysicsMuted] (2.8,.6)--(4.55,.6);
  \draw (3.55,.6) arc[start angle=0,end angle=30,radius=.75];
  \node at (3.8,.88) {$\theta$};
  \draw[->,PhysicsBlue,thick] (.25,2.2)--(1.25,2.2) node[right] {$v=\mathrm{const}$};
  \iflabforces
    \draw[physics force] (B)--++(0,-1.6) node[below] {$mg$};
    \draw[physics force] (B)--++(0,1.05) node[above] {$N$};
    \draw[physics force] (B)--++(-1.8,0) node[left] {$f_k$};
    \draw[->] (4,-.5)--(5,-.5) node[right] {$x$};
    \draw[->] (4,-.5)--(4,.25) node[above] {$y$};
  \fi
\end{tikzpicture}
