\begin{tikzpicture}[font=\small,>=Latex]
  \draw[physics line] (-.4,0)--(5.8,0);
  \draw[physics line,fill=PhysicsCyan] (.8,0) rectangle (1.8,.65);
  \draw[physics line,dashed] (4.3,0) rectangle (5.3,.65);
  \coordinate (B) at (1.3,.325);
  \draw[physics force] (B)--++(0,1.15) node[above] {$N$};
  \draw[physics force] (B)--++(0,-1.15) node[below] {$mg$};
  \draw[physics force] (B)--++(-1.35,0) node[left] {$\vec{\mathrm{fr}}$};
  \draw[->,PhysicsBlue,thick] (1.55,1.2)--(2.65,1.2) node[right] {$v$};
  \draw[->,PhysicsBlue,thick] (3.45,.4)--(2.35,.4) node[midway,above] {$a_x<0$};
  \node at (4.8,1.2) {$v_f=0$};
  \draw[physics dimension] (1.3,-1.5)--(4.8,-1.5) node[midway,below] {$L_2$};
  \draw[->] (4.7,-.55)--(5.65,-.55) node[right] {$x$};
