  \else
    \draw[physics line] (-.3,0)--(5.4,0);
    \draw[physics line,fill=PhysicsPaper] (0,0) rectangle(4.2,.55);
    \node at (2.1,.27) {$m_1$};
    \draw[physics line,fill=PhysicsCyan] (1.1,.55) rectangle(2.6,1.25);
    \node at (1.85,.9) {$m_2$};
    \draw[physics force] (2.6,.9)--(4.6,.9) node[right] {$F=pt$};
    \node[above left] at (1.1,.65) {$\mu$};
    \node[below] at (2.1,0) {Smooth ground};
    \draw[->] (4.1,-.9)--(5.25,-.9) node[right] {$x$};
  \fi
\end{tikzpicture}
