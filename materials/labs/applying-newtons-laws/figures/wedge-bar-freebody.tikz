\begin{tikzpicture}[font=\small,>=Latex]
  \draw[physics line,fill=PhysicsCyan] (-.4,-.35) rectangle (.4,.35);
  \node at (0,0) {$m$};
  \draw[physics force] (0,-.25)--(0,-1.5) node[below] {$mg$};
  \draw[physics force] (-.22,.25)--(-.22,1.45) node[above left] {$T$};
  \draw[physics force] (.22,.25)--(.22,1.35) node[above right] {$\vec{\mathrm{fr}}$};
  \draw[physics force] (.3,0)--(1.6,0) node[right] {$N$};
  \draw[->,PhysicsBlue,thick] (-1.1,-.75)--(-.45,-1.4)
    node[left,pos=0] {$\mathbf a$};
  \draw[->] (3.4,-1.2)--(4.35,-1.2) node[right] {$x$};
  \draw[->] (3.4,-1.2)--(3.4,-.4) node[above] {$y$};
  \draw[physics line,rounded corners] (2,1.3) rectangle (4.4,2.25);
  \node at (3.2,1.78) {$M+m$};
  \draw[physics force] (4.4,1.78)--(5.4,1.78) node[right] {$T$};
  \node[align=center,PhysicsMuted] at (3.3,.75) {Horizontal balance\\of the whole system};
\end{tikzpicture}
