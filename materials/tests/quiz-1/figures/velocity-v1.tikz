\begin{tikzpicture}
\begin{axis}[width=11cm,height=4.6cm,axis lines=middle,
 xmin=0,xmax=15,ymin=-1,ymax=10,
 xlabel={$t$ (\unit{s})},ylabel={$v$ (\unit{\metre\per\second})},
 xtick={0,2,4,6,8,10,12,14},ytick={0,4,8},
 xlabel style={at={(axis description cs:1,0)},anchor=north east,yshift=-15pt},
 tick label style={font=\small},label style={font=\small},
