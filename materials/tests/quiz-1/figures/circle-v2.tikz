\begin{tikzpicture}[font=\small]
\draw[physics line] (0,1.5) circle (1.5);
\draw[dashed] (0,0)--(0,1.5) node[pos=.75,left] {$R$};
\fill (0,1.5) circle (1.5pt) node[right] {$C$};
\fill (0,0) circle (1.5pt) node[below] {$(-1,3)\,\unit{m}$};
\draw[physics force] (0,0)--(0,.9) node[midway,right] {$\mathbf a$};
\draw[physics force] (0,0)--(1.1,0) node[right] {$\mathbf v$};
\draw[-{Latex}] (-2.1,-.3)--(-1.25,-.3) node[right] {$x$};
\draw[-{Latex}] (-2.1,-.3)--(-2.1,.55) node[above] {$y$};
\node at (0,-.85) {Schematic; axes indicate directions};
\end{tikzpicture}
