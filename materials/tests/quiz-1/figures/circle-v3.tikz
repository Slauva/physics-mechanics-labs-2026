\begin{tikzpicture}[font=\small]
\draw[physics line] (0,1.5) circle (1.5);
\draw[dashed] (0,0)--(0,3) node[pos=.7,left] {$R$};
\fill (0,1.5) circle (1.5pt) node[right] {$C$};
\fill (0,0) circle (1.5pt) node[below] {$P_0=(-10,10)\,\unit{m}$};
\fill (0,3) circle (1.5pt) node[above] {$P_1$};
\draw[physics force] (0,0)--(0,.9) node[midway,right] {$\mathbf a_0$};
\draw[physics force] (0,0)--(-1.1,0) node[left] {$\mathbf v_0$};
\draw[physics force] (0,3)--(1.1,3) node[right] {$\mathbf v_1$};
\draw[physics accent,-{Latex}] ({1.65*cos(55)},{1.5+1.65*sin(55)})
 arc[start angle=55,end angle=20,radius=1.65];
\draw[-{Latex}] (-2.85,.65)--(-2.1,.65) node[right] {$x$};
\draw[-{Latex}] (-2.85,.65)--(-2.85,1.4) node[above] {$y$};
\node at (0,-.85) {Schematic; clockwise motion};
\end{tikzpicture}
