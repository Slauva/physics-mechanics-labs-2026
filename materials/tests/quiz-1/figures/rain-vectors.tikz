\begin{tikzpicture}[font=\small]
\foreach \dx/\uw/\ind in {0/1/1,4/2/2}{
\begin{scope}[xshift=\dx cm]
\coordinate (O) at (2.3,2.2);
\coordinate (W) at ({2.3-\uw},2.2);
\coordinate (V) at ({2.3-\uw},{2.2-sqrt(3)});
\draw[physics force] (O)--(W) node[midway,above] {$u_{\ind}$};
\draw[physics force] (W)--(V) node[midway,left] {$v_y$};
\draw[physics accent,-{Latex}] (O)--(V)
 node[pos=.8,below right,fill=white,inner sep=1pt] {$\mathbf v_{\ind}$};
\draw[dashed] (O)--(2.3,.2);
\pgfmathsetmacro{\rainangle}{270-atan(\uw/sqrt(3))}
\draw (2.3,1.6) arc[start angle=270,end angle=\rainangle,radius=.6];
\node at (2.05,1.25) {$\alpha_{\ind}$};
\node at (1.3,-.05) {State $\ind$};
\end{scope}}
\end{tikzpicture}
